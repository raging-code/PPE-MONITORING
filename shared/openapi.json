{
  "openapi": "3.1.0",
  "info": {
    "title": "PPE Monitoring host REST API",
    "version": "1"
  },
  "paths": {},
  "components": {
    "schemas": {
      "ErrorEnvelope": {
        "additionalProperties": false,
        "properties": {
          "error_code": {
            "enum": [
              "BAD_REQUEST",
              "UNAUTHENTICATED",
              "ORIGIN_REJECTED",
              "NOT_FOUND",
              "RECOVERING",
              "STATE_CONFLICT",
              "VALIDATION_ERROR",
              "INTERNAL_ERROR"
