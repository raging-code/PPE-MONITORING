            "title": "Error Code",
            "type": "string"
          },
          "detail": {
            "title": "Detail",
            "type": "string"
          },
          "retry_after_s": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Retry After S"
          }
        },
        "required": [
          "error_code",
          "detail",
          "retry_after_s"
        ],
        "title": "ErrorEnvelope",
        "type": "object"
      }
